        <mxCell id="etcd" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;banco chave-valor&lt;br&gt;estado do cluster" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
