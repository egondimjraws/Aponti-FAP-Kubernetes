        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;kube-scheduler&lt;/b&gt;&lt;br&gt;escolhe em qual Node o Pod roda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
