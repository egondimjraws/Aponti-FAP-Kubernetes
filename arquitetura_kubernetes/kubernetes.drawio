        </mxCell>
        <mxCell id="nota_pods" value="Pods são &lt;b&gt;efêmeros&lt;/b&gt;: se um Pod falhar, o ReplicaSet cria outro (&lt;i&gt;self-healing&lt;/i&gt;) e o IP muda — por isso o acesso é feito pelo &lt;b&gt;Service&lt;/b&gt;, que encontra os Pods pela label.&lt;br&gt;Contêineres do mesmo Pod compartilham IP, portas e volumes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fillColor=#FFFFFF;strokeColor=#CCCCCC;rounded=1;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="815" width="560" height="100" as="geometry" />
        </mxCell>

