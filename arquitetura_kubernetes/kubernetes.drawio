        <mxCell id="service" value="&lt;b&gt;Service: meu-app-python-service&lt;/b&gt;&lt;br&gt;tipo: NodePort&lt;br&gt;ClusterIP :80 → targetPort 5000&lt;br&gt;selector: app=meu-app-python&lt;br&gt;balanceia entre os Pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#1A4AA8;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1">
